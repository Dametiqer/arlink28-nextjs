    "worker": "node dist/worker.js",
    "worker:dev": "ts-node-dev --transpile-only src/worker.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.15",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
