# Copy to apps/api/.env for local dev. In production (cPanel/Passenger) set
# these in the Node.js app's environment instead — no .env file on the server.
NODE_ENV=development
PORT=3001
DATABASE_URL="mysql://root@127.0.0.1:3306/arlink28"
# Browser origins allowed to call the API (web, admin), comma-separated.
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
# fatal | error | warn | info | debug | trace | silent (default info). Logs are
# JSON lines; pretty-printed only when NODE_ENV=development.
LOG_LEVEL=info
# Per-client-IP rate limit on public routes (health is exempt).
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
# Express "trust proxy": false locally. Production behind cPanel's
# Apache/Passenger must set 1 so the limiter sees the real client IP.
TRUST_PROXY=false
# Swagger UI at /docs (spec at /docs/openapi.json). Unset = on everywhere
# except NODE_ENV=production; set true to expose it on a staging deploy.
# SWAGGER_ENABLED=true
