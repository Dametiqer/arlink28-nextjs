// Package catalogue schema — see docs/packages-api-plan.md §3 for the model
// rationale and invariants. Bookings, payments, users etc. (DESIGN.md in
// arlink-static-web) land in later migrations.
//
// Conventions:
//   - ids are UUIDv7 strings generated by the API (CHAR(36))
//   - money is BIGINT minor units + CHAR(3) ISO currency — never floats
//   - timestamps are DATETIME(3) in UTC
//   - CHECK constraints Prisma can't express live in the migration SQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum PackageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PricingBasis {
  PER_PARTY
  PER_PERSON
}

enum FeatureSection {
  INCLUDED
  PREMIUM_SERVICE
  HIGHLIGHT
  VEHICLE
  PERK
  EXCLUDED
  NOTE
}

enum AddOnUnit {
  PER_STAY
  PER_NIGHT
  PER_DAY
  PER_PERSON
}

enum MediaRole {
  HERO
  GALLERY
  POSTER
}

// Videos are embedded from these hosts, never stored on cPanel (ADR 0003).
enum VideoProvider {
  YOUTUBE
  VIMEO
}

model Destination {
  id         String     @id @db.Char(36)
  slug       String     @unique @db.VarChar(80)
  name       String     @db.VarChar(120)
  country    String     @db.Char(2)
  createdAt  DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.DateTime(3)
  properties Property[]
  packages   Package[]

  @@map("destinations")
}

model Partner {
  id         String     @id @db.Char(36)
  slug       String     @unique @db.VarChar(80)
  name       String     @db.VarChar(120)
  tagline    String?    @db.VarChar(200)
  logoPath   String?    @map("logo_path") @db.VarChar(255)
  createdAt  DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.DateTime(3)
  properties Property[]
  seasons    Season[]

  @@map("partners")
}

model Property {
  id            String          @id @db.Char(36)
  slug          String          @unique @db.VarChar(80)
  name          String          @db.VarChar(120)
  partnerId     String          @map("partner_id") @db.Char(36)
  destinationId String          @map("destination_id") @db.Char(36)
  createdAt     DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.DateTime(3)
  partner       Partner         @relation(fields: [partnerId], references: [id])
  destination   Destination     @relation(fields: [destinationId], references: [id])
  stays         PackageStay[]
  media         PropertyMedia[]

  @@index([partnerId])
  @@index([destinationId])
  @@map("properties")
}

model Package {
  id             String        @id @db.Char(36)
  slug           String        @unique @db.VarChar(120)
  status         PackageStatus @default(DRAFT)
  title          String        @db.VarChar(160)
  subtitle       String?       @db.VarChar(200)
  summary        String        @db.VarChar(500)
  description    String?       @db.Text
  category       String        @db.VarChar(40)
  destinationId  String        @map("destination_id") @db.Char(36)
  nights         Int           @db.SmallInt
  minNights      Int           @map("min_nights") @db.SmallInt
  adults         Int           @db.TinyInt
  children       Int           @default(0) @db.TinyInt
  pricingBasis   PricingBasis  @default(PER_PARTY) @map("pricing_basis")
  baseCurrency   String        @default("USD") @map("base_currency") @db.Char(3)
  fromPriceMinor BigInt?       @map("from_price_minor")
  featured       Boolean       @default(false)
  sortOrder      Int           @default(0) @map("sort_order")
  seoTitle       String?       @map("seo_title") @db.VarChar(160)
  seoDescription String?       @map("seo_description") @db.VarChar(300)
  version        Int           @default(1)
  publishedAt    DateTime?     @map("published_at") @db.DateTime(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.DateTime(3)

  destination Destination      @relation(fields: [destinationId], references: [id])
  stays       PackageStay[]
  features    PackageFeature[]
  rates       PackageRate[]
  addOns      PackageAddOn[]
  media       PackageMedia[]

  @@index([status, category])
  @@index([status, destinationId])
  @@index([status, featured, sortOrder])
  @@index([destinationId])
  @@map("packages")
}

model PackageStay {
  id         String   @id @db.Char(36)
  packageId  String   @map("package_id") @db.Char(36)
  propertyId String   @map("property_id") @db.Char(36)
  nights     Int      @db.SmallInt
  roomType   String?  @map("room_type") @db.VarChar(120)
  sortOrder  Int      @map("sort_order") @db.SmallInt
  package    Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id])

  @@index([packageId, sortOrder])
  @@index([propertyId])
  @@map("package_stays")
}

model Feature {
  id              String           @id @db.Char(36)
  key             String           @unique @db.VarChar(80)
  label           String           @db.VarChar(160)
  icon            String           @db.VarChar(60)
  createdAt       DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.DateTime(3)
  packageFeatures PackageFeature[]

  @@map("features")
}

model PackageFeature {
  id            String         @id @db.Char(36)
  packageId     String         @map("package_id") @db.Char(36)
  section       FeatureSection
  featureId     String?        @map("feature_id") @db.Char(36)
  labelOverride String?        @map("label_override") @db.VarChar(300)
  footnote      String?        @db.VarChar(300)
  sortOrder     Int            @map("sort_order") @db.SmallInt
  package       Package        @relation(fields: [packageId], references: [id], onDelete: Cascade)
  feature       Feature?       @relation(fields: [featureId], references: [id])

  @@index([packageId, section, sortOrder])
  @@index([featureId])
  @@map("package_features")
}

model Season {
  id        String        @id @db.Char(36)
  // Stable natural key for seeds and admin URLs (e.g. "safari-collection-savings-2026").
  slug      String        @unique @db.VarChar(80)
  name      String        @db.VarChar(120)
  partnerId String?       @map("partner_id") @db.Char(36)
  createdAt DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.DateTime(3)
  partner   Partner?      @relation(fields: [partnerId], references: [id])
  ranges    SeasonRange[]
  rates     PackageRate[]

  @@index([partnerId])
  @@map("seasons")
}

model SeasonRange {
  id        String   @id @db.Char(36)
  seasonId  String   @map("season_id") @db.Char(36)
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  season    Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@index([seasonId, startDate])
  @@map("season_ranges")
}

model PackageRate {
  id                   String  @id @db.Char(36)
  packageId            String  @map("package_id") @db.Char(36)
  seasonId             String  @map("season_id") @db.Char(36)
  currency             String  @db.Char(3)
  priceMinor           BigInt  @map("price_minor")
  extraNightPriceMinor BigInt? @map("extra_night_price_minor")
  package              Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  season               Season  @relation(fields: [seasonId], references: [id])

  @@unique([packageId, seasonId, currency])
  @@index([seasonId])
  @@map("package_rates")
}

model PackageAddOn {
  id          String    @id @db.Char(36)
  packageId   String    @map("package_id") @db.Char(36)
  name        String    @db.VarChar(160)
  description String?   @db.VarChar(500)
  unit        AddOnUnit
  currency    String    @db.Char(3)
  priceMinor  BigInt    @map("price_minor")
  sortOrder   Int       @map("sort_order") @db.SmallInt
  package     Package   @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId, sortOrder])
  @@map("package_add_ons")
}

// A photo or video on a package. For a video, path/width/height describe its
// thumbnail and the video itself stays on YouTube or Vimeo (ADR 0003).
// Migration CHECKs: videoProvider and videoId are set together; videos are
// GALLERY only, so HERO and POSTER are always photos.
model PackageMedia {
  id            String         @id @db.Char(36)
  packageId     String         @map("package_id") @db.Char(36)
  role          MediaRole      @default(GALLERY)
  path          String         @unique @db.VarChar(255)
  alt           String         @db.VarChar(200)
  caption       String?        @db.VarChar(300)
  width         Int
  height        Int
  videoProvider VideoProvider? @map("video_provider")
  videoId       String?        @map("video_id") @db.VarChar(40)
  variantsReady Boolean        @default(false) @map("variants_ready")
  sortKey       String         @map("sort_key") @db.VarChar(32)
  createdAt     DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  package       Package        @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId, role, sortKey])
  @@map("package_media")
}

// A lodge's own gallery (rooms, views, activities), uploaded once and shown on
// every package that stays there. Same shape and CHECKs as PackageMedia, minus role.
model PropertyMedia {
  id            String         @id @db.Char(36)
  propertyId    String         @map("property_id") @db.Char(36)
  path          String         @unique @db.VarChar(255)
  alt           String         @db.VarChar(200)
  caption       String?        @db.VarChar(300)
  width         Int
  height        Int
  videoProvider VideoProvider? @map("video_provider")
  videoId       String?        @map("video_id") @db.VarChar(40)
  variantsReady Boolean        @default(false) @map("variants_ready")
  sortKey       String         @map("sort_key") @db.VarChar(32)
  createdAt     DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  property      Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, sortKey])
  @@map("property_media")
}

// Append-only trail of admin writes (plan D9). actor_id is a plain column,
// not an FK, until the users table lands with staff auth.
model AuditLog {
  id         String   @id @db.Char(36)
  actorId    String?  @map("actor_id") @db.Char(36)
  action     String   @db.VarChar(80)
  entityType String   @map("entity_type") @db.VarChar(40)
  entityId   String   @map("entity_id") @db.Char(36)
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
  @@map("audit_log")
}
